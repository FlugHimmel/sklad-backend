# ─── Django ─────────────────────────────────────────────
# Сгенерировать: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=YOUR_SERVER_IP,example.com,www.example.com,localhost,127.0.0.1

# ─── PostgreSQL ─────────────────────────────────────────
DB_NAME=sklad_db
DB_USER=sklad_user
DB_PASSWORD=replace-me
DB_HOST=127.0.0.1
DB_PORT=5432

# ─── JWT ────────────────────────────────────────────────
JWT_ACCESS_HOURS=8
JWT_REFRESH_DAYS=14

# ─── CORS ───────────────────────────────────────────────
# В проде Flutter Web обычно на том же домене, поэтому можно False.
# В деве, если клиент на localhost:PORT — поставь True или список origin.
CORS_ALLOW_ALL=False

# ─── CSRF (для админки по HTTPS) ────────────────────────
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
